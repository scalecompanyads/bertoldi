# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Use a chave "anon" (eyJ...) ou "publishable" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (ex: https://bertoldi.vercel.app ou http://localhost:3000)
# Necessária para links de convite e redefinição de senha nos e-mails
NEXT_PUBLIC_SITE_URL=

# WhatsApp do escritório (somente dígitos, com DDI, ex: 5518999999999)
# Habilita o botão "Falar com o escritório" na área do cliente
NEXT_PUBLIC_WHATSAPP_ESCRITORIO=

# Datajud — API pública do CNJ (chave pública documentada na wiki)
# https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=

# Resend — envio de e-mails (digest de intimações/movimentações e avisos ao cliente)
# Crie a chave em https://resend.com/api-keys — sem ela, os e-mails são silenciosamente pulados
RESEND_API_KEY=
# Remetente verificado no Resend (ex: "Bertoldi Advocacia <avisos@seudominio.com.br>")
# Sem domínio verificado, use onboarding@resend.dev (só entrega para o e-mail da conta Resend)
EMAIL_FROM=
