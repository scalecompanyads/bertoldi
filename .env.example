# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública: "anon" (eyJ…) ou "publishable" (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional — alias aceito pelo app se ANON_KEY não estiver definida
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (ex: https://bertoldi-zeta.vercel.app ou https://interno.advbertoldi.com.br)
# Necessária para links de convite e redefinição de senha nos e-mails
# Também adicione a mesma URL em Supabase → Authentication → URL Configuration (Site URL + Redirect URLs /auth/callback)
NEXT_PUBLIC_SITE_URL=

# WhatsApp do escritório (somente dígitos, com DDI, ex: 5518999999999)
# Habilita o botão "Falar com o escritório" na área do cliente
NEXT_PUBLIC_WHATSAPP_ESCRITORIO=

# Datajud — API pública do CNJ (chave pública documentada na wiki)
# https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=

# Resend — envio de e-mails (digest de intimações/movimentações e avisos ao cliente)
# Crie a chave em https://resend.com/api-keys — sem ela, os e-mails são silenciosamente pulados
RESEND_API_KEY=
# Remetente verificado no Resend (ex: "Bertoldi Advocacia <avisos@seudominio.com.br>")
# Sem domínio verificado, use onboarding@resend.dev (só entrega para o e-mail da conta Resend)
EMAIL_FROM=

# Segredo compartilhado com o Vercel Cron. As rotas /api/cron/* exigem
# Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Teste de carga da Onda 1 — banco isolado (nunca o projeto de produção)
# DATABASE_URL_TEST=postgresql://...
# LOAD_TEST_CONFIRM=ISOLATED_DATABASE
# LOAD_TEST_PROCESSOS=5000

# Playwright / axe (opcional)
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_CLIENT_EMAIL=
# E2E_CLIENT_PASSWORD=
# E2E_CLIENT_PROCESSO_ID=
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
